# Provider selection: "minimax" or "glm"
AUTONOVEL_PROVIDER=minimax

# MiniMax API key (required when using minimax provider)
MINIMAX_API_KEY=your-m...here

# Z.AI/GLM API key (required when using glm provider)
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Writer model (used for drafting and revision)
AUTONOVEL_WRITER_MODEL=auto

# Judge model (used for evaluation — should differ from writer)
AUTONOVEL_JUDGE_MODEL=auto

# Review model (deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=auto

# API base URL (MiniMax only - GLM uses GLM_BASE_URL)
MINIMAX_API_BASE_URL=https://api.minimax.io/anthropic

# Optional metadata for reusable export/art scripts
AUTONOVEL_TITLE=Untitled Novel
AUTONOVEL_AUTHOR=Author

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
